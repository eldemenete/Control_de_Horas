# Puerto del servidor (Render y Railway lo asignan automáticamente)
PORT=3000

# URL de conexión a PostgreSQL (en Render/Railway se inyecta automáticamente)
# Ejemplo: postgres://usuario:password@host:5432/basedatos
DATABASE_URL=

# Meta de horas de práctica profesional
GOAL_HOURS=360

# PIN opcional para proteger el acceso a tu app desde internet (déjalo vacío si no quieres PIN)
APP_PIN=
